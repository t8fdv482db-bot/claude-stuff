# Copy to .env and fill in. Never commit .env.

# --- Provider keys ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=

# --- Provider selection (mock = offline, free, for testing) ---
# script:  claude | mock
ADGEN_SCRIPT_PROVIDER=claude
# portrait: flux2pro | mock
ADGEN_PORTRAIT_PROVIDER=flux2pro
# voice:   elevenlabs | mock
ADGEN_VOICE_PROVIDER=elevenlabs
# lipsync: kling_avatar_v2_pro | kling_avatar_v2_standard | omnihuman_v15 | mock
ADGEN_LIPSYNC_PROVIDER=kling_avatar_v2_pro
# music:   elevenlabs | library | none | mock
ADGEN_MUSIC_PROVIDER=elevenlabs

# --- Models ---
ADGEN_CLAUDE_MODEL=claude-opus-5-5
ADGEN_TTS_MODEL=eleven_v3

# --- Paths (optional) ---
# ADGEN_OUTPUT_DIR=output
# ADGEN_AVATAR_DIR=avatars
# ADGEN_MUSIC_LIBRARY=assets/music
# ADGEN_FONT_FILE=/path/to/Inter-ExtraBold.otf
