--!nocheck
local Context = require("../harness/Context")

return function(T)
	local describe, it, expect = T.describe, T.it, T.expect
	local ctx = Context.new()
	local RarityConfig = ctx.get("ReplicatedStorage/Shared/Config/RarityConfig")
	local BrainrotConfig = ctx.get("ReplicatedStorage/Shared/Config/BrainrotConfig")
	local UpgradeConfig = ctx.get("ReplicatedStorage/Shared/Config/UpgradeConfig")
	local EventConfig = ctx.get("ReplicatedStorage/Shared/Config/EventConfig")
	local ConfigValidator = ctx.get("ReplicatedStorage/Shared/Config/ConfigValidator")

	describe("ConfigValidator", function()
		it("finds no problems in the shipped configs", function()
			local problems = ConfigValidator.Validate()
			expect(#problems).toBe(0)
		end)
		it("detects broken weights", function()
			local old = RarityConfig.Tiers.Common.weight
			RarityConfig.Tiers.Common.weight = 10
			local problems = ConfigValidator.Validate()
			RarityConfig.Tiers.Common.weight = old
			expect(#problems).toBeGreaterThan(0)
			expect(problems[1]).toContain("sum")
		end)
	end)

	describe("RarityConfig", function()
		it("has the specified odds", function()
			local expected = { Common = 55, Uncommon = 25, Rare = 12, Epic = 5, Legendary = 2.5, Mythic = 0.45, Secret = 0.05 }
			for name, w in expected do
				expect(RarityConfig.Get(name).weight).toBe(w)
			end
		end)
		it("scales steal hold time from 1s Common to 4s Mythic", function()
			expect(RarityConfig.Get("Common").stealHoldSeconds).toBe(1)
			expect(RarityConfig.Get("Mythic").stealHoldSeconds).toBe(4)
		end)
		it("compares rarities", function()
			expect(RarityConfig.AtLeast("Mythic", "Legendary")).toBe(true)
			expect(RarityConfig.AtLeast("Rare", "Legendary")).toBe(false)
		end)
		it("keeps the secret tier event-only", function()
			expect(RarityConfig.Get("Secret").eventOnly).toBe("BloodOrangeMoon")
		end)
	end)

	describe("BrainrotConfig", function()
		it("has the full original roster", function()
			expect(#BrainrotConfig.Roster).toBe(15)
			local counts = {}
			for _, b in BrainrotConfig.Roster do
				counts[b.rarity] = (counts[b.rarity] or 0) + 1
			end
			expect(counts.Common).toBe(3)
			expect(counts.Uncommon).toBe(3)
			expect(counts.Rare).toBe(3)
			expect(counts.Epic).toBe(2)
			expect(counts.Legendary).toBe(2)
			expect(counts.Mythic).toBe(1)
			expect(counts.Secret).toBe(1)
		end)
		it("applies mutation income multipliers", function()
			expect(BrainrotConfig.IncomeFor("BooFfin", nil)).toBe(3)
			expect(BrainrotConfig.IncomeFor("BooFfin", "Golden")).toBe(9)
			expect(BrainrotConfig.IncomeFor("BooFfin", "RainbowEctoplasm")).toBe(15)
			expect(BrainrotConfig.IncomeFor("Nope", nil)).toBe(0)
		end)
	end)

	describe("UpgradeConfig", function()
		it("prices upgrades exponentially and caps at max level", function()
			local c0 = UpgradeConfig.UpgradeCost("WalkSpeed", 0)
			local c1 = UpgradeConfig.UpgradeCost("WalkSpeed", 1)
			expect(c0).toBe(400)
			expect(c1).toBeGreaterThan(c0)
			expect(UpgradeConfig.UpgradeCost("WalkSpeed", 10)).toBe(nil)
			expect(UpgradeConfig.UpgradeValue("WalkSpeed", 3)).toBe(19)
		end)
		it("keeps the max gate duration shorter than its cooldown", function()
			local maxDuration = UpgradeConfig.UpgradeValue("GateDuration", UpgradeConfig.Upgrades.GateDuration.maxLevel)
			expect(maxDuration).toBeLessThan(UpgradeConfig.Gate.cooldownSeconds)
		end)
		it("unlocks floors 3/4/5 at rebirths 1/3/5", function()
			expect(UpgradeConfig.Floors[3].rebirthRequired).toBe(1)
			expect(UpgradeConfig.Floors[4].rebirthRequired).toBe(3)
			expect(UpgradeConfig.Floors[5].rebirthRequired).toBe(5)
			expect(UpgradeConfig.RebirthMultiplier(0)).toBe(1)
			expect(UpgradeConfig.RebirthMultiplier(1)).toBe(1.5)
			expect(UpgradeConfig.RebirthMultiplier(99)).toBe(30)
		end)
	end)

	describe("EventConfig", function()
		it("maps clock times to phases", function()
			expect(EventConfig.PhaseAt(12).name).toBe("Day")
			expect(EventConfig.PhaseAt(18).name).toBe("Dusk")
			expect(EventConfig.PhaseAt(23).name).toBe("Night")
			expect(EventConfig.PhaseAt(0.5).name).toBe("Night")
			expect(EventConfig.PhaseAt(5.5).name).toBe("Dawn")
		end)
		it("uses a 12 minute day and a 90 second raid", function()
			expect(EventConfig.DayCycle.lengthSeconds).toBe(720)
			expect(EventConfig.Raid.durationSeconds).toBe(90)
			expect(EventConfig.SecondsPerHour).toBe(30)
		end)
		it("keeps disco lighting changes slow (photosensitivity)", function()
			expect(EventConfig.Events.GhostDisco.params.lightCycleSeconds >= 1).toBe(true)
		end)
	end)
end
