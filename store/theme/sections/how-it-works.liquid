<section class="section section--dark" id="how-it-works">
  <div class="container">
    <div class="center narrow" style="margin:0 auto 32px">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <ol class="steps">
      {%- for block in section.blocks -%}
        <li class="step" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.title }}</h3>
          <p class="muted">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.video_url != blank -%}
      <p class="center" style="margin-top:28px"><a class="btn btn--primary" href="{{ section.settings.video_url }}" target="_blank" rel="noopener">Watch the 40-second demo</a></p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps. About a minute." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "The magnet holds your blade at a fixed angle. The roller does the rest." },
    { "type": "text", "id": "video_url", "label": "Demo video link (TikTok/YouTube)" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "title", "label": "Title", "default": "Step" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the step." }
    ] }
  ],
  "presets": [{ "name": "How it works" }]
}
{% endschema %}
