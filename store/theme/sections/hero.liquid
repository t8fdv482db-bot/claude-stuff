<section class="hero">
  <div class="container hero__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      <p class="hero__sub">{{ section.settings.subheading }}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn--ghost" href="{{ section.settings.button2_link }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
      <ul class="trust-row">
        {%- if section.settings.trust_1 != blank -%}<li>{% render 'icon', name: 'truck' %}{{ section.settings.trust_1 }}</li>{%- endif -%}
        {%- if section.settings.trust_2 != blank -%}<li>{% render 'icon', name: 'shield' %}{{ section.settings.trust_2 }}</li>{%- endif -%}
        {%- if section.settings.trust_3 != blank -%}<li>{% render 'icon', name: 'gift' %}{{ section.settings.trust_3 }}</li>{%- endif -%}
      </ul>
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'eager', sizes: '(min-width: 900px) 50vw, 100vw' }}
      {%- else -%}
        <img src="{{ 'keenroll-placeholder.svg' | asset_url }}" alt="Keenroll rolling knife sharpener with magnetic angle block" width="800" height="800">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The rolling knife sharpener" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dull knife to paper-slicing sharp in about a minute." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Stick your knife to the magnet, roll 20 times, flip, repeat. The angle is locked in, so there's no skill, no whetstone soaking, and no chewed-up edges." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get your Keenroll" },
    { "type": "text", "id": "button_link", "label": "Button link", "default": "/products/keenroll-rolling-knife-sharpener" },
    { "type": "text", "id": "button2_label", "label": "Secondary button label", "default": "See how it works" },
    { "type": "text", "id": "button2_link", "label": "Secondary button link", "default": "#how-it-works" },
    { "type": "text", "id": "trust_1", "label": "Trust point 1", "default": "Free US shipping" },
    { "type": "text", "id": "trust_2", "label": "Trust point 2", "default": "60-day guarantee" },
    { "type": "text", "id": "trust_3", "label": "Trust point 3", "default": "Gift-ready box" },
    { "type": "image_picker", "id": "image", "label": "Image (use your own photo)" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
